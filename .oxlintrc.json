{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn"],
  "env": {
    "browser": true
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "AGENTS.md",
    "README.md",
    ".vscode/**",
    "public/**",
    "dist/**",
    "node_modules/**"
  ]
}
